{
  "name": "pi-side-agent",
  "version": "0.1.0",
  "type": "module",
  "description": "A side agent for pi: a second full pi agent in a resizable window that keeps its own model, tools, skills, and MCP servers, and can read and message the main agent.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "side-agent",
    "tui"
  ],
  "license": "MIT",
  "author": "Ahrav Dutta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahrav/pi-side-agent.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./extensions/side-agent/index.ts"
    ]
  },
  "files": [
    "extensions",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bench": "node evals/bench.mjs",
    "eval": "node evals/run.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.6.1",
    "@earendil-works/pi-coding-agent": "^1.6.1",
    "@earendil-works/pi-tui": "^1.6.1",
    "@types/node": "^24",
    "typebox": "*",
    "typescript": "^5.6.0"
  }
}
